# Plantilla de variables del backend. Copia este archivo a `.env` y rellena los valores.
#   cp backend/.env.example backend/.env
# El archivo real `.env` está en .gitignore (no subir secretos).

# --- 1. CONFIGURACIÓN DEL SERVIDOR (FastAPI) ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# --- 2. BASE DE DATOS RELACIONAL (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mydb

# URL para SQLAlchemy (localhost si el backend corre fuera de Docker; 'postgres' si corre dentro)
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- 3. MENSAJERÍA Y EVENTOS (Apache Kafka) ---
# Puerto 9094 para que el backend (fuera de Docker) conecte
KAFKA_BROKER_URL=localhost:9094
KAFKA_INCIDENT_TOPIC=robot_incidents
KAFKA_TELEMETRY_TOPIC=robot_telemetry
KAFKA_ROBOT_COMMANDS_TOPIC=robot_commands

# --- 4. ALMACENAMIENTO DE OBJETOS (MinIO) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=tfg-incidentes

# --- 5. SERIES TEMPORALES Y TELEMETRÍA (InfluxDB) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=CHANGE_ME
INFLUXDB_ORG=tfg_org
INFLUXDB_BUCKET=tfg_bucket
INFLUXDB_TOKEN=CHANGE_ME

# --- 6. VISUALIZACIÓN (Grafana) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME
# URL base que abre el navegador del cliente (NO la interna grafana:3000)
GRAFANA_URL=http://localhost:3000

# --- 7. SEGURIDAD BACKEND (JWT) ---
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
