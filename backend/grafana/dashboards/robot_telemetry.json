  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["tfg", "robot"],
  "templating": {
    "list": [
      {
        "name": "robot_id",
        "label": "Robot",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"tfg_bucket\", tag: \"robot_id\", predicate: (r) => r._measurement == \"robot_telemetry\")",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Robot Telemetry",
  "uid": "robot-telemetry",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "title": "Batería",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"tfg_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"robot_telemetry\")\n  |> filter(fn: (r) => r._field == \"bateria\")\n  |> filter(fn: (r) => r.robot_id == \"${robot_id}\")\n  |> last()"
        }
      ]
    },
    {
      "id": 2,
      "title": "Batería (histórico)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"tfg_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"robot_telemetry\")\n  |> filter(fn: (r) => r._field == \"bateria\")\n  |> filter(fn: (r) => r.robot_id == \"${robot_id}\")"
        }
      ]
    },
    {
      "id": 3,
      "title": "Voltaje batería",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"tfg_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"robot_telemetry\")\n  |> filter(fn: (r) => r._field == \"bateria_voltaje\")\n  |> filter(fn: (r) => r.robot_id == \"${robot_id}\")"
        }
      ]
    },
    {
      "id": 4,
      "title": "Velocidades",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"tfg_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"robot_telemetry\")\n  |> filter(fn: (r) => r._field == \"vel_linear\" or r._field == \"vel_angular\")\n  |> filter(fn: (r) => r.robot_id == \"${robot_id}\")"
        }
      ]
    },
    {
      "id": 5,
      "title": "Posición (X / Y)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"tfg_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"robot_telemetry\")\n  |> filter(fn: (r) => r._field == \"pos_x\" or r._field == \"pos_y\")\n  |> filter(fn: (r) => r.robot_id == \"${robot_id}\")"
        }
      ]
    },
    {
      "id": 6,
      "title": "Estado",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NO", "color": "red" }, "1": { "text": "SÍ", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"tfg_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"robot_telemetry\")\n  |> filter(fn: (r) => r._field == \"is_docked\" or r._field == \"is_kidnapped\" or r._field == \"is_slipping\" or r._field == \"wheels_enabled\")\n  |> filter(fn: (r) => r.robot_id == \"${robot_id}\")\n  |> last()\n  |> map(fn: (r) => ({ r with _value: if r._value then 1.0 else 0.0 }))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ]
    }
  ]
}
