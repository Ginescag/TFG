# Plantilla de variables del robot_ws (nodos corriendo en el HOST o vía Git Bash).
# Copia a `.env`:   cp robot_ws/.env.example robot_ws/.env
# Para los nodos DENTRO del contenedor docker existe además `.env.container`
# (mismas claves pero con direcciones internas: kafka:29092, minio:9000, host.docker.internal:8000).

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=tfg-incidentes

BACKEND_URL=http://localhost:8000

KAFKA_BROKER_URL=localhost:9094
KAFKA_INCIDENT_TOPIC=robot_incidents
KAFKA_TELEMETRY_TOPIC=robot_telemetry
KAFKA_ROBOT_COMMANDS_TOPIC=robot_commands

ROBOT_ID=RBT-01

DETECTION_CONFIDENCE_THRESHOLD=0.5

SECRET_PATH=/secrets/robot_token.txt
